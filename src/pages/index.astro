---
import '../styles/global.css';
const instagram = 'https://www.instagram.com/ktnailsandspa_128tolworth/';
const services = [
  { n: '01', title: 'Manicures & gel', text: 'A little polish, a whole new feeling. Explore soft neutrals, classic French tips and your favourite colours.', tag: 'THE EVERYDAY LUXURY', shape: 'polish' },
  { n: '02', title: 'Extensions & nail art', text: 'Your nails, your personality. From an elegant almond shape to a statement set made for you.', tag: 'SOMETHING UNIQUELY YOU', shape: 'nail' },
  { n: '03', title: 'Spa pedicures', text: 'Take a seat, settle in and give your feet a little attention. A moment to slow down and feel refreshed.', tag: 'A MOMENT OF CALM', shape: 'bowl' },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f3ef" />
    <meta name="description" content="Discover KT Nails & Spa at 128 Tolworth Broadway. Manicures, nail art and spa pedicures in a soft, welcoming salon. Get in touch to arrange your visit." />
    <title>KT Nails & Spa — A little time for you.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">YOUR LITTLE ESCAPE, RIGHT HERE IN TOLWORTH <span>✧</span></div>
    <header>
      <a href="#" class="brand" aria-label="KT Nails and Spa home"><span class="brand-main">KT <i>Nails & Spa</i></span><span class="brand-sub">TOLWORTH · LONDON</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>☰</span></button>
      <nav id="navigation" aria-label="Main navigation"><a href="#treatments">Treatments</a><a href="#our-space">Our space</a><a href="#inspiration">Nail inspiration</a><a href="#visit">Find us</a><a class="button small" href="#booking">Book a little me-time <span>↗</span></a></nav>
    </header>
    <main id="main">
      <section class="hero">
        <div class="hero-copy"><div class="eyebrow"><span></span> BEAUTIFUL NAILS. A BEAUTIFUL PAUSE.</div><h1>A little time<br />for <em>you.</em></h1><p>Fresh nails. A softer pace. Step into our little<br class="desktop" /> corner of calm on Tolworth Broadway.</p><div class="hero-actions"><a href="#booking" class="button">Make time for yourself <span>↗</span></a><a href="#treatments" class="text-link">Explore treatments <span>↓</span></a></div><div class="hero-note"><span class="sparkle">✧</span><span>From everyday elegance to something<br />a little more <i>you.</i></span></div></div>
        <div class="hero-visual"><img src="/images/manicure.png" alt="Illustrative blush French manicure on soft white faux fur" width="1024" height="1536" fetchpriority="high" /><div class="image-tint"></div><div class="floating-note"><span>the finishing touch</span><strong>Small details.<br /><i>Beautiful feeling.</i></strong><span class="note-star">✧</span></div><span class="image-caption">MANICURE INSPIRATION</span></div>
        <div class="vertical-label">NAILS, CARE & A LITTLE SELF-LOVE</div>
      </section>
      <div class="ribbon"><span>Perfectly polished</span><i>✧</i><span>A little everyday luxury</span><i>✧</i><span>Your colour. Your style.</span><i>✧</i><span>Time to unwind</span></div>
      <section id="treatments" class="section treatments"><div class="section-heading"><div><div class="eyebrow">THE TREATMENT EDIT</div><h2>Good nails.<br /><em>Even better feelings.</em></h2></div><p>A fresh set, a signature shade, or a well-earned pause.<br />Find your next little pick-me-up.</p></div><div class="service-grid">{services.map(service => <a href="#booking" class="service-card"><div class={`service-illustration ${service.shape}`} aria-hidden="true"><span></span><i></i><b>KT</b></div><div class="service-title"><h3>{service.title}</h3><span>↗</span></div><p>{service.text}</p><div class="service-foot"><span>{service.tag}</span><span>{service.n}</span></div></a>)}</div><p class="treatment-note">For the full treatment menu, current prices and availability, <a href={instagram} target="_blank" rel="noopener noreferrer">get in touch on Instagram ↗</a></p></section>
      <section id="our-space" class="space-section"><div class="space-art" aria-hidden="true"><div class="arch"><div class="chair"><div></div></div><div class="chair second"><div></div></div></div><span class="space-art-caption">A LITTLE CORNER OF CALM</span></div><div class="space-copy"><div class="eyebrow">WELCOME TO KT NAILS & SPA</div><h2>Come for the nails.<br /><em>Stay for the feeling.</em></h2><p>Soft blush tones. Marble touches. A comfortable seat and a little time that’s just yours.</p><p>Inspired by the warmth of our Tolworth salon, this is your invitation to step away from the everyday. Bring your favourite nail inspiration — or find a new favourite with us.</p><a href="#visit" class="text-link">Find your moment of calm <span>↗</span></a></div></section>
      <section id="inspiration" class="section inspiration"><div class="section-heading"><div><div class="eyebrow">A MOOD FOR EVERY MANICURE</div><h2>Find your <em>next set.</em></h2></div><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">See our work on Instagram <span>↗</span></a></div><div class="look-grid"><a href={instagram} target="_blank" rel="noopener noreferrer" class="look look-photo"><img src="/images/manicure.png" alt="French tip manicure inspiration" width="1024" height="1536" loading="lazy" /><span>01 / THE MODERN FRENCH <b>↗</b></span></a><a href={instagram} target="_blank" rel="noopener noreferrer" class="look look-blush"><div class="swatches" aria-hidden="true"><i></i><i></i><i></i></div><span>02 / BLUSH CRUSH <b>↗</b></span></a><a href={instagram} target="_blank" rel="noopener noreferrer" class="look look-bold"><div class="swatches" aria-hidden="true"><i></i><i></i><i></i></div><span>03 / A LITTLE DRAMA <b>↗</b></span></a></div><p class="gallery-note">An illustrative moodboard. Discover the salon’s actual nail sets at @ktnailsandspa_128tolworth.</p></section>
      <section id="booking" class="booking"><span class="booking-star" aria-hidden="true">✧</span><div class="eyebrow">YOUR NEXT LITTLE LUXURY</div><h2>Make room for <em>me-time.</em></h2><p>Your next favourite set starts with a hello.<br />Message us to ask about treatments and arrange your visit.</p><a class="button" href={instagram} target="_blank" rel="noopener noreferrer">Enquire on Instagram <span>↗</span></a><p class="booking-note">Appointments are confirmed directly with the salon.</p></section>
      <section id="visit" class="section visit"><div><div class="eyebrow">JUST AROUND THE CORNER</div><h2>See you in <em>Tolworth.</em></h2></div><div class="visit-address"><h3>KT Nails & Spa</h3><address>128 Tolworth Broadway<br />Tolworth, London</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=KT+Nails+and+Spa+128+Tolworth+Broadway" target="_blank" rel="noopener noreferrer">Get directions <span>↗</span></a></div><div class="visit-details"><h3>Plan your visit</h3><p>Please contact the salon for current<br />opening hours and appointment availability.</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Say hello on Instagram <span>↗</span></a></div></section>
    </main>
    <footer><a href="#" class="brand"><span class="brand-main">KT <i>Nails & Spa</i></span><span class="brand-sub">A LITTLE TIME FOR YOU.</span></a><p>© {new Date().getFullYear()} KT Nails & Spa</p><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="#">Back to top ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      const close = () => { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('open'); };
      toggle?.addEventListener('click', () => { const expanded = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!expanded)); nav?.classList.toggle('open', !expanded); });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') { close(); toggle?.focus(); } });
    </script>
  </body>
</html>
